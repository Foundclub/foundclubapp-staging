{
    "cli": {
        "version": ">= 3.0.0"
    },
    "build": {
        "preview": {
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "env": {
                "APP_ENV": "staging",
                "FC_DISABLE_DOCUMENT_PICKER": "0",
                "FC_DISABLE_NOTIFICATIONS_BOOTSTRAP": "0",
                "RCT_NEW_ARCH_ENABLED": "0"
            }
        },
        "staging": {
            "distribution": "internal",
            "ios": {
                "simulator": false
            },
            "env": {
                "APP_ENV": "staging",
                "FC_DISABLE_DOCUMENT_PICKER": "0",
                "FC_DISABLE_NOTIFICATIONS_BOOTSTRAP": "0",
                "RCT_NEW_ARCH_ENABLED": "0"
            }
        },
        "production": {
            "distribution": "store",
            "env": {
                "FC_DISABLE_DOCUMENT_PICKER": "0",
                "FC_DISABLE_NOTIFICATIONS_BOOTSTRAP": "0",
                "RCT_NEW_ARCH_ENABLED": "0"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
