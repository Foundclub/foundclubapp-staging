# Application
APP_NAME=
ENV=

# API URLs
API_URL=
STRAPI_URL=
SOCKET_URL=
WEB_APP_URL=

# URLs externes
DELETE_ACCOUNT_URL=
CONTACT_URL=
APP_STORE_URL=

# Firebase Configuration
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID_ANDROID=
FIREBASE_APP_ID_IOS=
FIREBASE_MEASUREMENT_ID=

# Local-only debug/bypass flags
BYPASS_FIREBASE_AUTH=false
ENABLE_DEV_BYPASS_ENDPOINTS=false
ENABLE_DEV_MATCHMAKING_DEBUG_ENDPOINT=false

# Analytics & Crashlytics
ANALYTICS_ENABLED=
CRASHLYTICS_ENABLED=

# Local secrets directory (outside workspace)
# Used by: npm run secrets:sync
FOUNDCLUB_SECRETS_DIR=

# Notifications
# true: enable push registration + handlers. Local stays opt-in; staging/production are enabled by build config.
FC_ENABLE_PUSH_NOTIFICATIONS=
# true: enable in-app smart notification surfaces alongside push.
FC_ENABLE_SMART_NOTIFICATIONS=
# true: enable local-only notification debug trigger UI/flows
FC_ENABLE_NOTIFICATION_TEST_TRIGGER=

# Search map provider
# legacy: keep the historical native/web map stack
# tomtom: use the TomTom Leaflet runtime on web + mobile
FC_SEARCH_MAP_PROVIDER=
TOMTOM_API_KEY=

# RevenueCat (clés publiques SDK, dashboard RC > API keys)
# Sans clé, le rail d'achat store est inerte ("Checkout indisponible").
REVENUECAT_APPLE_API_KEY=
REVENUECAT_GOOGLE_API_KEY=
# 1: force le rail RevenueCat sur un build local/staging (recette sandbox stores)
FC_FORCE_REVENUECAT_RAIL=
