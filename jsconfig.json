{
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0, // To avoid typing check from node_modules
    "jsx": "react-native",
    "target": "ES6",
    "module": "ES2022",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "lib": [ "es2022", "dom" ],
    "skipLibCheck": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "src/views/onboarding/.js", ],
  "exclude": [
    "node_modules/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "node_modules/react-native/Libraries/**",
    "**/*test.js",
    "vendor/**",
  ]
}