<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>

  <!-- PERMS (03/09/2026) - LES TROIS PERMISSIONS DE LECTURE MEDIA (images,
       video, audio) ONT ETE RETIREES D ICI, VOLONTAIREMENT. Elles etaient
       declarees sans qu une seule ligne de code les demande, et la politique
       Play "Photos et videos" (obligatoire depuis le 28/05/2025) impose un
       formulaire a toute app qui les declare sans besoin central.
       Choisir une photo continue de marcher sur tout le parc (minSdk 24) :
       react-native-image-picker 7.2.3 passe par PickVisualMedia d AndroidX,
       qui n exige aucune permission de lecture. La camera garde CAMERA.
       ATTENTION - NE PAS LES REMETTRE sans rouvrir le dossier Play. Le garde-fou
       executable, qui porte les noms exacts, la mesure et la raison, est
       src/platform/media/__tests__/androidMediaPermissions.test.js : il
       rougit si elles reviennent, ET si du code demande un jour une
       permission que ce fichier ne declare pas.
       (Les noms exacts ne sont pas ecrits ici : le fusionneur recopie les
       commentaires dans le manifeste fusionne, et un grep de controle
       rendrait une reponse non vide pour un simple commentaire.) -->

  <!-- READ/WRITE_EXTERNAL_STORAGE sont injectees par react-native-blob-util et
       react-native-nitro-sound sans plafond ; on les borne. WRITE reste
       DEMANDEE par le code sur Android 9 et anterieur (useShareCard.js:44 et
       shareLocalFile.native.js:125 : au-dela, MediaStore ecrit sans permission). -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

  <!-- R12 (02/09/2026) - TROIS PERMISSIONS QUE PERSONNE N A DEMANDEES.
       Elles arrivent par la fusion de manifestes depuis l AAR de notifee
       (node_modules/@notifee/react-native/android/libs/app/notifee/core/
       202108261754/core-202108261754.aar), pas par ce fichier. Elles
       apparaissent donc dans le rapport de pre-lancement Play et dans le
       formulaire de donnees, sans qu aucun ecran ne s en serve :
         . SCHEDULE_EXACT_ALARM et RECEIVE_BOOT_COMPLETED ne servent qu aux
           notifications PLANIFIEES. Mesure : 0 createTriggerNotification,
           0 TimestampTrigger, 0 TriggerType dans src/. Toutes nos
           notifications viennent du serveur par FCM, en temps reel.
         . FOREGROUND_SERVICE ne sert qu a notifee.registerForegroundService.
           Mesure : 0 appel dans src/.
       tools:node="remove" les retire du manifeste FUSIONNE, sans toucher a
       la bibliotheque. Le jour ou on planifie une notification, il faudra
       retirer la ligne correspondante ICI - sinon elle ne partira jamais.
       Precision de politique : le formulaire Play "alarmes exactes" ne
       concerne que USE_EXACT_ALARM, absent du projet. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-feature android:name="android.hardware.camera.front" android:required="false"/>

  <queries>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="text/plain" />
    </intent>
  </queries>

  <!-- R12 (02/09/2026) - android:usesCleartextTraffic="true" a ete RETIRE de
       cette balise. Il autorisait le HTTP en clair dans l AAB de production,
       alors que les deux fichiers .env produits par la CI ne portent que des
       URL https. Le debogage garde le sien : src/debug/AndroidManifest.xml:6
       le pose pour le type de build debug, donc Metro et le rechargement a
       chaud ne changent pas. -->
  <application
  android:name=".MainApplication"
  android:label="@string/app_name"
  android:icon="@mipmap/ic_launcher"
  android:roundIcon="@mipmap/ic_launcher_round"
  android:allowBackup="false"
  android:theme="@style/AppTheme"
  android:supportsRtl="true">
    <meta-data android:name="com.google.android.geo.API_KEY" android:value="${googleMapsApiKey}" />
    <meta-data  android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_notification" />
    <activity android:name=".MainActivity" android:label="@string/app_name" android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/SplashTheme" android:screenOrientation="portrait" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="foundclub"/>
      </intent-filter>
      <!-- Y03 : liens d'invitation en https. autoVerify exige que CHAQUE hote
           serve /.well-known/assetlinks.json en application/json, sans redirection.
           Tant qu'un hote ne le sert pas, Android n'ouvre pas l'app tout seul :
           il propose le choix. Rien ne casse, la verification est simplement KO. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="foundclub.app"/>
        <data android:scheme="https" android:host="www.foundclub.app"/>
        <data android:scheme="https" android:host="staging.foundclub.app"/>
        <data android:scheme="https" android:host="api.foundclubpro.com"/>
        <data android:scheme="https" android:host="api-staging.foundclubpro.com"/>
        <data android:pathPrefix="/i/"/>
        <data android:pathPrefix="/install.html"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
